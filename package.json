{
  "name": "prince-net",
  "version": "1.0.0",
  "private": true,
  "description": "Prince Net Management System",
  "packageManager": "pnpm@11.28.0",
  "engines": {
  "node": ">=22.13.0",
  "pnpm": ">=11.28.0"
},
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "build:apps": "pnpm -r --filter \"./apps/*\" build",
    "build": "pnpm build:packages && pnpm build:apps",
    "start": "pnpm --filter @prince-net/api start:prod",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter @prince-net/api prisma:generate",
    "prisma:migrate": "pnpm --filter @prince-net/api prisma:migrate",
    "prisma:deploy": "pnpm --filter @prince-net/api prisma:deploy",
    "prisma:seed": "pnpm --filter @prince-net/api prisma:seed",
    "prisma:studio": "pnpm --filter @prince-net/api prisma:studio",
    "clean": "rimraf node_modules apps/api/node_modules apps/web/node_modules packages/types/node_modules packages/validation/node_modules packages/config/node_modules apps/api/dist apps/web/dist packages/types/dist packages/validation/dist packages/config/dist"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.5.4"
  }
}

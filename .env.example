# ─────────────────────────────────────────────────────────────
# Prince Net Management System — Environment Example
# انسخ هذا الملف إلى .env وعدّل القيم
# لا تضع أي قيمة حقيقية في هذا الملف
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
# قالب عام portable — استبدل DB_USER و DB_PASSWORD في .env الحقيقي
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/prince_net?schema=public"

# JWT (يُستخدم داخل HttpOnly Cookie)
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"
JWT_COOKIE_NAME="prince_net_token"

# Cookies / Security
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
CSRF_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS"
CSRF_COOKIE_NAME="prince_net_csrf"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Admin (يُستخدم فقط في Seed)
ADMIN_EMAIL="admin@prince-net.local"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS"

# App
APP_NAME="Prince Net"
APP_CURRENCY="ريال"
APP_CURRENCY_SYMBOL="ر.ي"

# Backups
# ⚠️ يجب أن يكون مسارًا مطلقًا، خارج أي web root / public directory.
#
# Production (Serv00):
# BACKUP_DIR="/var/prince-net/backups"
#
# Local development (Termux):
BACKUP_DIR="/data/data/com.termux/files/home/prince-net-data/backups"

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Web (Vite)
VITE_API_BASE_URL="http://localhost:3000/api/v1"
VITE_APP_NAME="Prince Net"

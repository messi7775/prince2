# Base44 dev image — installs pnpm + workspace deps, used by api/web/migrate services.
# Source is bind-mounted at runtime; node_modules are preserved via named volumes.
FROM node:22-bookworm-slim

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# curl for compose healthchecks
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl procps \
    && rm -rf /var/lib/apt/lists/*

# pnpm (pinned to the project's packageManager)
RUN corepack enable && corepack prepare pnpm@11.28.0 --activate

WORKDIR /app

# Copy only manifests so deps are cached independently of source changes
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/types/package.json packages/types/
COPY packages/validation/package.json packages/validation/
COPY packages/config/package.json packages/config/

RUN pnpm install --frozen-lockfile
